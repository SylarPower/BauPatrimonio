rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function owner(uid) {
      return request.auth != null
        && request.auth.uid == uid
        && request.auth.token.email_verified == true;
    }
    function validVault() {
      return request.resource.data.keys().hasAll(['payload', 'revision'])
        && request.resource.data.keys().hasOnly(['payload', 'revision'])
        && request.resource.data.payload is string
        && request.resource.data.payload.size() <= 900000
        && request.resource.data.revision is int;
    }
    match /vaults/{uid} {
      allow get: if owner(uid);
      allow list: if false;
      allow create: if owner(uid) && validVault()
        && request.resource.data.revision == 1;
      allow update: if owner(uid) && validVault()
        && request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
