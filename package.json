{
  "name": "baupatrimonio",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "test": "vitest run src",
    "preview": "vite preview --host 0.0.0.0",
    "test:e2e": "playwright test",
